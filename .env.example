# =========================================================================
# CONFIGURATION DE L'ENVOI DE MAILS - CYBERWIZE (AGILLY)
# Copiez ce fichier et renommez-le en ".env.local" pour le développement.
# =========================================================================

# L'adresse email de l'équipe Agilly qui recevra les demandes d'accès et de devis
AGILLY_CONTACT_EMAIL=contact@agilly.net

# -------------------------------------------------------------------------
# OPTION A : RESEND (Recommandé - Simple et Rapide)
# 1. Créez un compte gratuit sur https://resend.com
# 2. Récupérez votre clé d'API et mettez-la ci-dessous.
# -------------------------------------------------------------------------
RESEND_API_KEY=re_DkEbcLQt_4p3TXnLnS1XoyWCh7dkn9iik

# -------------------------------------------------------------------------
# OPTION B : SMTP CLASSIQUE (Utilisation de votre propre serveur mail / Hostinger)
# Si vous préférez utiliser votre propre serveur SMTP, renseignez les infos :
# -------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@agilly.net
SMTP_PASS=votre_mot_de_passe_secret
# EXPEDITEUR_EMAIL doit correspondre au SMTP_USER autorisé par votre hébergeur
EMAIL_FROM="Cyberwize Family <no-reply@agilly.net>"
